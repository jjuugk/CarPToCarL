<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 应用名**不含** CarPlay：它既是 Apple 的商标，用「CarPlay」作产品名会构成
         商标性使用（且容易被误认为官方产品）。兼容关系写在副标题/README 里，
         那属于描述性引用。详见仓库根目录 DISCLAIMER.md 与 README「非官方声明」。 -->
    <string name="app_name">CarPToCarL</string>
    <string name="navigation_now_playing_label">仪表转向指引</string>
    <string name="navigation_now_playing_note">通过“正在播放”显示导航的转向文字和箭头；数据源跟随下面的开关（CarLife 或手机高德）。</string>
    <string name="amap_navi_source_label">使用手机高德地图获取导航数据</string>
    <string name="amap_navi_source_note">打开后仪表和“正在播放”的转向都只读手机高德地图，CarLife 的转向指引不再使用；需先在高德中开始导航。</string>
    <string name="amap_navi_source_diagnose">查看高德数据源自检 ›</string>
    <string name="arrow_dark_tile_label">转向箭头加深色底</string>
    <string name="arrow_dark_tile_note">官方箭头是纯白透明底，在浅色“正在播放”卡片上会看不见。打开后发「深底白箭头」（JPEG）；关着则原样发送官方 PNG。</string>
</resources>
