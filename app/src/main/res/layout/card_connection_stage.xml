<?xml version="1.0" encoding="utf-8"?>
<!-- 连接阶段：参考 hypercar 的 ConnectionStageCard，用本工程已有的
     bg_card / 绿色令牌改写成 XML。每一行都是「本机观察到的事实」，
     绿灯只表示这一步被本机确认，不代表车机已显示画面或已出声。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/connectionStageCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/stageDot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_stage_dot" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="连接阶段"
            android:textColor="@color/m3_on_surface"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stageMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="等待数据"
            android:textColor="@color/m3_mono_dim"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/stageHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="尚未发起连接"
        android:textColor="@color/m3_mono_dim"
        android:textSize="11.5sp" />

    <TextView
        android:id="@+id/stageActivation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/stageControl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/stageChannels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textSize="11sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="9dp"
        android:background="#1AFFFFFF" />

    <TextView
        android:id="@+id/stageDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/stageTiming"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/stageTcp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="绿灯只表示本机确认到这一步，不代表车机已显示或出声"
        android:textColor="#6F8080"
        android:textSize="10sp" />
</LinearLayout>
