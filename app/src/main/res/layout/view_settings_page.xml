<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页：2026-11-25 从首页拆出「显示 / 连接实验 · 排查用 / 流分辨率」三块。
     所有控件 ID 保持不变，MainActivity 里原有的绑定与点击逻辑无需改动。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSettingsBack"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_tbtn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:text="‹ 返回"
                android:textColor="@color/m3_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="设置"
                android:textColor="#EDF3F3"
                android:textSize="21sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="28dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- 设置页内容（2026-11-25 从首页移入）：显示 / 连接实验 / 流分辨率。
            原注释：
                 本地 CarLife 劫持开关 + 流分辨率缩放 + 触摸注入节流
                 （目标帧率设置已移除：固定 60fps，见 DisplayPrefs.FPS） -->
            <LinearLayout
                android:id="@+id/displayCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icon_tile">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="显示"
                            android:src="@drawable/ic_menu_display" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="显示"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="分辨率缩放 · 音频重启手势 · 劫持开关"
                            android:textColor="@color/m3_on_var"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="52dp"
                    android:background="#5A394444" />

                <!-- 本地 CarLife 劫持开关 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="本地 CarLife 劫持"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/carLifeHijackNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="接管手机原生 CarLife 的码流直推车机（不改分辨率压缩）。"
                            android:textColor="@color/m3_on_var"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        xmlns:app="http://schemas.android.com/apk/res-auto"
                        android:id="@+id/switchCarLifeHijack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:thumb="@drawable/sw_thumb"
                        app:track="@drawable/sw_track" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="52dp"
                    android:background="#5A394444" />
                <!-- 使用车机 GPS（0x18010 车机 → CarLife） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="使用车机 GPS"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/carGpsNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="车机有定位时把它的坐标转给 CarLife，车内手机信号差时更准；车机只发无坐标样本时自动不发。"
                            android:textColor="@color/m3_on_var"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        xmlns:app="http://schemas.android.com/apk/res-auto"
                        android:id="@+id/switchCarGps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:thumb="@drawable/sw_thumb"
                        app:track="@drawable/sw_track" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="52dp"
                    android:background="#5A394444" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/navigation_now_playing_label"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/navigation_now_playing_note"
                            android:textColor="@color/m3_on_var"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        xmlns:app="http://schemas.android.com/apk/res-auto"
                        android:id="@+id/switchNavigationNowPlaying"
                        android:contentDescription="@string/navigation_now_playing_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:thumb="@drawable/sw_thumb"
                        app:track="@drawable/sw_track" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="52dp"
                    android:background="#5A394444" />

                <!-- 高德导航数据源：打开后**替换** CarLife 0x10030，不是叠加 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/amap_navi_source_label"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/amap_navi_source_note"
                            android:textColor="@color/m3_on_var"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnAmapDiagnose"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:text="@string/amap_navi_source_diagnose"
                            android:textColor="@color/m3_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        xmlns:app="http://schemas.android.com/apk/res-auto"
                        android:id="@+id/switchAmapNaviSource"
                        android:contentDescription="@string/amap_navi_source_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:thumb="@drawable/sw_thumb"
                        app:track="@drawable/sw_track" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="52dp"
                    android:background="#5A394444" />

                <!-- 转向箭头加深色底：只影响媒体卡片（0x5001 封面位）的箭头字节 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/arrow_dark_tile_label"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/arrow_dark_tile_note"
                            android:textColor="@color/m3_on_var"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        xmlns:app="http://schemas.android.com/apk/res-auto"
                        android:id="@+id/switchArrowDarkTile"
                        android:contentDescription="@string/arrow_dark_tile_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:thumb="@drawable/sw_thumb"
                        app:track="@drawable/sw_track" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="52dp"
                    android:background="#5A394444" />

                <!-- 媒体采样率策略：点击循环 自动 → 48kHz → 44.1kHz -->
                <LinearLayout
                    android:id="@+id/rowAudioRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="媒体采样率"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/audioRateNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="不改引擎采样率，也不改音频档顺序（原有行为）"
                            android:textColor="@color/m3_on_var"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/audioRateValue"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_icon_tile"
                        android:gravity="center"
                        android:minWidth="56dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="自动"
                        android:textColor="@color/m3_on_var"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 音频兼容实验：点击循环 关 → A → B → A+B（默认关，对所有车型生效） -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="52dp"
                    android:background="#5A394444" />

                <LinearLayout
                    android:id="@+id/rowAudioCompatExperiment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="音频兼容实验"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/audioCompatNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="不改音频行为（默认）"
                            android:textColor="@color/m3_on_var"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/audioCompatValue"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_icon_tile"
                        android:gravity="center"
                        android:minWidth="56dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="关"
                        android:textColor="@color/m3_on_var"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 音频队列治理：点击切换 关/开（默认关，音频卡顿时可开启尝试） -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="52dp"
                    android:background="#5A394444" />

                <LinearLayout
                    android:id="@+id/rowAudioQueueGovernor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">


                    <TextView
                        android:id="@+id/audioQueueValue"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_icon_tile"
                        android:gravity="center"
                        android:minWidth="56dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="关"
                        android:textColor="@color/m3_on_var"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- ===== 连接实验（三项，均默认关） ===== -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="52dp"
                    android:background="#5A394444" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="连接实验 · 排查用"
                    android:textColor="@color/m3_on_var"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/rowVideoReadyGate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">


                    <TextView
                        android:id="@+id/videoReadyValue"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_icon_tile"
                        android:gravity="center"
                        android:minWidth="56dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="关"
                        android:textColor="@color/m3_on_var"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="52dp"
                    android:background="#5A394444" />

                <LinearLayout
                    android:id="@+id/rowMfiCertBytes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">


                    <TextView
                        android:id="@+id/mfiCertValue"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_icon_tile"
                        android:gravity="center"
                        android:minWidth="56dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="关"
                        android:textColor="@color/m3_on_var"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="52dp"
                    android:background="#5A394444" />

                <LinearLayout
                    android:id="@+id/rowFeatureTrim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="精简能力清单"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/featureTrimNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="默认关：按 iPhone 全量清单提议 14 项。若连上后个别功能半开、操作无响应，可开启此项。下次连接起效。"
                            android:textColor="@color/m3_on_var"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/featureTrimValue"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_icon_tile"
                        android:gravity="center"
                        android:minWidth="56dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="关"
                        android:textColor="@color/m3_on_var"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 方向盘语音键三连击 → 重启音频（默认开） -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="52dp"
                    android:background="#5A394444" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="车机麦克风上行（AMcar 实验）"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/amcarMicUplinkNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="默认关。打开后引擎请求车机麦（0x10024）才开一路输入流，解密并降到 16k 后写回 9242；CarWith 的麦克风来源需手动选「车机」。"
                            android:textColor="@color/m3_on_var"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        xmlns:app="http://schemas.android.com/apk/res-auto"
                        android:id="@+id/switchAmcarMicUplink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:thumb="@drawable/sw_thumb"
                        app:track="@drawable/sw_track" />
                </LinearLayout>

                <!-- 连上后主动取一次主音频（实验，默认关）：不按车机指纹，由用户按车型开启 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="连上后主动取主音频"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="部分车机没有音频会话就不交屏，必须等手机放首歌才进 CarPlay。打开后连上 1.5 秒自动取一次主音频；下次连接生效。实验项，默认关闭。"
                            android:textColor="@color/m3_on_var"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        xmlns:app="http://schemas.android.com/apk/res-auto"
                        android:id="@+id/switchProactiveAudio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:thumb="@drawable/sw_thumb"
                        app:track="@drawable/sw_track" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnRestartAudio"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_icon_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="立即重启一次"
                    android:textColor="@color/m3_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- 流分辨率缩放 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="流分辨率"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <SeekBar
                        android:id="@+id/displayScaleSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="26" />

                    <TextView
                        android:id="@+id/displayScaleValue"
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="end"
                        android:text="100%"
                        android:textColor="@color/m3_on_var"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/displayScaleNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="保存后下次连接起效"
                    android:textColor="@color/m3_on_var"
                    android:textSize="12sp" />

                <!-- 车机分辨率（只读）：来自车机 AirPlay /info，没连接时显示上次会话的快照 -->
                <TextView
                    android:id="@+id/displayResolutionNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="连接后自动读取车机分辨率"
                    android:textColor="@color/m3_primary"
                    android:textSize="12.5sp" />

                <!-- 触摸域自适应（默认关）：上报坐标域比画面大时按观测上限线性映射 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="触摸域自适应"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/adaptiveTouchNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="当车机上报的触摸坐标比画面大（点右侧总落到右边缘、拖拽幅度对不上）时打开：按实测的最大坐标把上报域缩到画面尺寸。默认关闭，只影响触摸，不改分辨率。"
                            android:textColor="@color/m3_on_var"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        xmlns:app="http://schemas.android.com/apk/res-auto"
                        android:id="@+id/switchAdaptiveTouch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:thumb="@drawable/sw_thumb"
                        app:track="@drawable/sw_track" />
                </LinearLayout>

                <!-- 车机占屏时保留视频流（实验，默认关）：车机借屏放转向/倒车影像时不再拆流 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="车机占屏时保留视频流"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="车机借屏放转向/倒车影像后，旧行为是拆掉屏幕流、归还时整套重建，实测每轮 100~170ms 又被夺走。打开后占屏期间不断流，归还时补关键帧 + 重武装触摸立即恢复。实验项，默认关闭。"
                            android:textColor="@color/m3_on_var"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        xmlns:app="http://schemas.android.com/apk/res-auto"
                        android:id="@+id/switchKeepScreenStream"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:thumb="@drawable/sw_thumb"
                        app:track="@drawable/sw_track" />
                </LinearLayout>
            </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
